{
  "crons": [
    {
      "path": "/api/worker",
      "schedule": "*/1 * * * *"
    }
  ],
  "functions": {
    "app/api/audio/route.ts": {
      "maxDuration": 60
    },
    "app/api/youtube/route.ts": {
      "maxDuration": 120
    },
    "app/api/worker/route.ts": {
      "maxDuration": 300
    },
    "app/api/translate/route.ts": {
      "maxDuration": 30
    },
    "app/api/reverse/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
